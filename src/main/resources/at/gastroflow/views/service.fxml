<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="at.gastroflow.controller.ServiceController" styleClass="root-pane">
    <top>
        <VBox spacing="5" styleClass="header">
            <Label text="GastroFlow" styleClass="brand"/>
            <Label text="Service · Tischauswahl &amp; Bestellungen" styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
            <content>
                <VBox spacing="18" styleClass="content">
                    <Label text="1. Tisch auswählen" styleClass="section-title"/>
                    <FlowPane fx:id="tableButtons" hgap="10" vgap="10" prefWrapLength="800"/>
                    <Separator/>
                    <VBox fx:id="orderArea" spacing="12">
                        <Label fx:id="tableLabel" text="Bitte Tisch auswählen" styleClass="section-title"/>
                        <HBox spacing="20">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="2. Speisekarte" styleClass="section-title"/>
                                <ListView fx:id="menuList" prefHeight="260" prefWidth="440"/>
                                <Button text="Produkt hinzufügen" onAction="#addProduct" styleClass="primary-button"/>
                            </VBox>
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="3. Aktuelle Bestellung" styleClass="section-title"/>
                                <ListView fx:id="orderList" prefHeight="200" prefWidth="440"/>
                                <HBox spacing="10">
                                    <Button text="+ Menge" onAction="#increaseQuantity"/>
                                    <Button text="− Menge / Entfernen" onAction="#decreaseQuantity"/>
                                </HBox>
                                <Label fx:id="totalLabel" text="Gesamt: 0,00 €" styleClass="total"/>
                            </VBox>
                        </HBox>
                        <Label text="4. Sonderwünsche" styleClass="section-title"/>
                        <TextArea fx:id="noteArea" promptText="z. B. ohne Zwiebeln" prefRowCount="2" wrapText="true"/>
                        <Button text="Bestellung absenden" onAction="#sendOrder" styleClass="primary-button"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
