<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.gastroflow.frontend.controller.KitchenController"
            stylesheets="@../styles/kitchen.css"
            styleClass="root-shell">

    <!-- Kopfzeile -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="header">

            <Label text="KÜCHE"
                   styleClass="brand"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Abmelden"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </HBox>
    </top>

    <!-- Hauptinhalt -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="page-scroll">

            <content>
                <VBox spacing="28"
                      styleClass="content-layout">

                    <!-- Überschrift -->
                    <VBox spacing="8">
                        <Label text="Küchenübersicht"
                               styleClass="page-title"/>

                        <Label text="Eine Karte pro Tisch, Gang für Gang. Getränke bringt der Service."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_LEFT">

                        <VBox spacing="16"
                              prefWidth="300"
                              minWidth="0"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                            <VBox spacing="6" styleClass="stat-card, column-new">
                                <Label text="NEU"
                                       styleClass="stat-title"/>
                                <Label fx:id="newCount"
                                       text="0"
                                       styleClass="stat-number"/>
                                <Label text="Warten auf Zubereitung"
                                       wrapText="true"
                                       styleClass="stat-description"/>
                            </VBox>

                            <VBox fx:id="newColumn" spacing="16"/>
                        </VBox>

                        <!-- In Zubereitung -->
                        <VBox spacing="16"
                              prefWidth="300"
                              minWidth="0"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                            <VBox spacing="6" styleClass="stat-card, column-preparing">
                                <Label text="IN ZUBEREITUNG"
                                       styleClass="stat-title"/>
                                <Label fx:id="preparingCount"
                                       text="0"
                                       styleClass="stat-number"/>
                                <Label text="Werden gerade zubereitet"
                                       wrapText="true"
                                       styleClass="stat-description"/>
                            </VBox>

                            <VBox fx:id="preparingColumn" spacing="16"/>
                        </VBox>

                        <VBox spacing="16"
                              prefWidth="300"
                              minWidth="0"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS">

                            <VBox spacing="6" styleClass="stat-card, column-finished">
                                <Label text="FERTIG"
                                       styleClass="stat-title"/>
                                <Label fx:id="finishedCount"
                                       text="0"
                                       styleClass="stat-number"/>
                                <Label text="Bereit zur Abholung oder nächster Gang"
                                       wrapText="true"
                                       styleClass="stat-description"/>
                            </VBox>

                            <VBox fx:id="finishedColumn" spacing="16"/>
                        </VBox>

                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
